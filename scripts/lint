#!/usr/bin/env node
// em-tools lint. Fails on:
//   1. em-dashes anywhere in the repo,
//   2. send, post or write calls in skills, examples and the server, and write tools on the read allowlist,
//   3. per-person ranking or per-person numbers in team-level outputs,
//   4. a missing HR and legal line, verdict language in underperformance records, and names or
//      blame wording in postmortems.
//
// Usage: scripts/lint   (exit 0 clean, 1 on any finding)

import { execFileSync } from "node:child_process";
import { readFileSync, readdirSync, existsSync } from "node:fs";
import { dirname, join, relative } from "node:path";
import { fileURLToPath } from "node:url";
import { looksReadOnly } from "../hooks/guard.mjs";

const ROOT = join(dirname(fileURLToPath(import.meta.url)), "..");
const findings = [];
const report = (file, line, rule, text) => findings.push({ file, line, rule, text: text.trim().slice(0, 160) });

function repoFiles() {
  const out = execFileSync("git", ["ls-files", "--cached", "--others", "--exclude-standard"], { cwd: ROOT, encoding: "utf8" });
  return out.split("\n").filter(Boolean).filter((f) => existsSync(join(ROOT, f)));
}
const isText = (f) => !/\.(png|jpe?g|gif|ico|zip|mcpb)$/i.test(f);
const lines = (f) => readFileSync(join(ROOT, f), "utf8").split("\n");

// 1. Em-dashes -----------------------------------------------------------------------
const EM_DASH = String.fromCharCode(0x2014);
for (const f of [...new Set([...repoFiles().filter(isText), ...walk("examples")])]) {
  lines(f).forEach((l, i) => l.includes(EM_DASH) && report(f, i + 1, "em-dash", l));
}

// 2. Send, post and write calls --------------------------------------------------------
const WRITE_CALLS = /\b(slack_send_\w+|slack_schedule_message|slack_create_canvas|slack_add_reaction|chat\.postMessage|send_message|send_email|create_event|update_event|delete_event|respond_to_event|save_issue|save_comment|save_status_update|create_attachment|createJiraIssue|editJiraIssue|transitionJiraIssue|addCommentToJiraIssue|addOrEditJiraIssueComment|create_pull_request|merge_pull_request|add_issue_comment|issue_write|push_files|create_or_update_file|create_entity_work_iq|update_entity_work_iq|delete_entity_work_iq|do_action_work_iq|call_function_work_iq)\b/;
const sendScope = (f) => f.startsWith("skills/") || f.startsWith("server/src/");
for (const f of repoFiles().filter((x) => isText(x) && sendScope(x))) {
  lines(f).forEach((l, i) => WRITE_CALLS.test(l) && report(f, i + 1, "send-or-post-call", l));
}
for (const f of walk("examples")) {
  lines(f).forEach((l, i) => WRITE_CALLS.test(l) && report(f, i + 1, "send-or-post-call", l));
}
// The server must make no network calls at all.
for (const f of repoFiles().filter((x) => x.startsWith("server/src/"))) {
  lines(f).forEach((l, i) => /\bfetch\(|from "node:(http|https|net|dgram)"|from "(http|https|net)"|XMLHttpRequest|WebSocket/.test(l) && report(f, i + 1, "network-call-in-server", l));
}
// Every allowlisted tool for an official server must read as read-only.
const allow = JSON.parse(readFileSync(join(ROOT, "hooks/read-allowlist.json"), "utf8"));
for (const [server, entry] of Object.entries(allow.servers)) {
  if (entry.allow === "*") continue;
  for (const tool of entry.allow) if (!looksReadOnly(tool)) report("hooks/read-allowlist.json", 0, "write-tool-on-allowlist", `${server}: ${tool}`);
}

// 3. Per-person ranking ------------------------------------------------------------------
// People come from the fixtures, so the check knows every name, slug and login.
const people = [];
for (const team of ["team-a", "team-b"]) {
  const dir = join(ROOT, "fixtures/notes", team, "people");
  if (!existsSync(dir)) continue;
  for (const f of readdirSync(dir).filter((x) => x.endsWith(".md"))) {
    const text = readFileSync(join(dir, f), "utf8");
    const name = /^name: (.+)$/m.exec(text)?.[1].trim();
    const login = /^github: (.+)$/m.exec(text)?.[1].trim();
    if (name) people.push({ name, first: name.split(" ").pop(), login, slug: f.slice(0, -3) });
  }
}
const nameRe = (p) => new RegExp(`\\b(${[p.name, p.first, p.login, p.slug].filter(Boolean).map((s) => s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")).join("|")})\\b`, "i");
const RANKING = /\b(leaderboard|top (contributor|performer|user)s? (is|are|were|was|list)|bottom performers?|lowest performers?|most productive (engineer|person|developer)|least productive|ranked (list|by)|ranking of (engineers|people|the team))\b/i;
const METRIC_WITH_NUMBER = /\b\d+(\.\d+)?\s*%?\s*(prs?|pull requests|commits|lines|tickets|points|reviews|active days|deploys?)\b/i;

// Examples are generated locally and git-ignored, so read them from disk.
function walk(dir) {
  if (!existsSync(join(ROOT, dir))) return [];
  return readdirSync(join(ROOT, dir), { withFileTypes: true }).flatMap((e) => (e.isDirectory() ? walk(`${dir}/${e.name}`) : [`${dir}/${e.name}`]));
}
const examples = walk("examples").filter((f) => f.endsWith(".md"));
// Examples must never be committed: they contain synthetic people in sensitive situations.
for (const f of repoFiles().filter((x) => x.startsWith("examples/"))) report(f, 0, "example-tracked-in-git", "examples/ is local only");
for (const f of examples) {
  const ls = lines(f);
  ls.forEach((l, i) => RANKING.test(l) && !/\b(no|never|not|without|don't|doesn't|won't|refuse)\b/i.test(l) && report(f, i + 1, "per-person-ranking", l));
  const teamLevel = /^examples\/(ai-adoption|team-delivery-health|oncall-health|postmortem-draft|capacity-plan|tech-debt-register|team-pulse)\//.test(f);
  const update = /^examples\/(upward-update|dependency-register)\//.test(f);
  ls.forEach((l, i) => {
    const named = people.filter((p) => nameRe(p).test(l));
    if (teamLevel && named.length) report(f, i + 1, "person-named-in-team-output", l);
    if (update && named.length && METRIC_WITH_NUMBER.test(l)) report(f, i + 1, "per-person-number-in-update", l);
    if (!teamLevel && named.length >= 2 && METRIC_WITH_NUMBER.test(l) && /^\s*\|/.test(l)) report(f, i + 1, "people-compared-in-table", l);
  });
}

// 4. HR and legal line on outputs that need it ------------------------------------------------
const NEEDS_HR = /\b(underperform\w*|wellbeing|well-being|burnout|burn(ed|t|ing) out|governance kit|usage policy)\b/i;
for (const f of examples) {
  const text = readFileSync(join(ROOT, f), "utf8");
  const needs = f.startsWith("examples/review-packet/") || f.startsWith("examples/underperformance-record/") || f.startsWith("examples/calibration-prep/") || NEEDS_HR.test(text);
  if (needs && !/check with your HR or legal team/i.test(text)) report(f, 0, "missing-hr-legal-line", "Add: check with your HR or legal team");
}

// 6. Blameless postmortems: no managers named and no blame wording ----------------------------
// Engineers are caught by person-named-in-team-output above; managers have no person file.
const MANAGER = /\bManager [A-Z]\b/;
const BLAME = /\b(should have|failed to|careless(ly)?|human error|(his|her|their) (mistake|fault)|mistake by|fault of|to blame)\b/i;
for (const f of examples.filter((x) => x.startsWith("examples/postmortem-draft/"))) {
  lines(f).forEach((l, i) => {
    if (MANAGER.test(l)) report(f, i + 1, "person-named-in-team-output", l);
    if (BLAME.test(l)) report(f, i + 1, "blame-in-postmortem", l);
  });
}

// 5. No verdicts in underperformance records --------------------------------------------------
const VERDICT = /\b(risk score|risk of (failing|leaving)|likely to (fail|leave|improve)|recommend(ed|s)? (a |starting a )?(PIP|performance improvement plan)|should be (put on|placed on) a (PIP|performance improvement plan)|(is|are) (an? )?(low|poor|under)[- ]?performer|grounds for (dismissal|termination))\b/i;
// A refusal may quote the question ("I can't say whether X is likely to fail"). Only a refusal
// earlier in the same clause excuses a match, so "X is a low performer and cannot improve" still fails.
const REFUSAL = /\b(can't|cannot|won't|will not|refuse[sd]?|decline[sd]?|not|whether)\b/i;
// "You asked for X, but I won't" restates a request before declining it. "You asked" alone is not
// a refusal, so it only counts when the same line also declines.
const RESTATED = /\byou asked\b/i;
const DECLINES = /\b(can't|cannot|won't|will not|refuse[sd]?|decline[sd]?|not|never|only)\b/i;
const CLAUSE_BREAK = /[.;:!?]|\b(and|but|so)\b/gi;
function verdictIn(line, re = VERDICT) {
  for (const m of line.matchAll(new RegExp(re.source, "gi"))) {
    const before = line.slice(0, m.index);
    const breaks = [...before.matchAll(CLAUSE_BREAK)];
    const clause = breaks.length ? before.slice(breaks.at(-1).index + breaks.at(-1)[0].length) : before;
    if (REFUSAL.test(clause)) continue;
    if (RESTATED.test(clause) && DECLINES.test(line.slice(m.index + m[0].length))) continue;
    return true;
  }
  return false;
}
for (const f of examples.filter((x) => x.startsWith("examples/underperformance-record/"))) {
  lines(f).forEach((l, i) => verdictIn(l) && report(f, i + 1, "verdict-in-record", l));
}

// 7. No candidate verdicts in hiring outputs --------------------------------------------------
// "Which candidate to hire" and "whether to hire" ask the question rather than answer it.
const HIRING_VERDICT = /\b((strong |lean )?(no[- ])?(?<!\b(to|whether|should we|do we|would we|will we|can we|who do we|which to) )hire\b(?! (manager|plan|date|process|decision|team|loop))|strong (yes|no)|best candidate|top candidate|stronger candidate|weaker candidate|recommend (hiring|rejecting|an offer)|should (hire|reject|make an offer)|ranked (first|second|higher|lower)|overall score|average score|total score)/i;
for (const f of examples.filter((x) => x.startsWith("examples/hiring-loop-kit/"))) {
  lines(f).forEach((l, i) => verdictIn(l, HIRING_VERDICT) && report(f, i + 1, "verdict-in-hiring", l));
}

// 8. No activity quotas in onboarding plans -----------------------------------------------------
const QUOTA = /\b\d+\s*(PRs?|pull requests|commits|tickets|issues|story points|points|lines( of code)?)\s*(per|a|each|every)\s*(day|week|sprint|cycle|month)\b/i;
for (const f of examples.filter((x) => x.startsWith("examples/onboarding-plan/"))) {
  // A refusal earlier in the same clause ("I will not set a target of 3 PRs per week") is fine.
  lines(f).forEach((l, i) => verdictIn(l, QUOTA) && report(f, i + 1, "activity-quota-in-onboarding", l));
}

// 9. Calibration: one person per page, no suggested ratings ----------------------------------
const SUGGESTED_RATING = /\b((suggested|recommended|proposed) rating|should be rated|rate (them|him|her|this person) (as|at)|would rate|stack rank|forced (ranking|distribution)|ranked (above|below|ahead of))\b/i;
for (const f of examples.filter((x) => x.startsWith("examples/calibration-prep/"))) {
  const ls = lines(f);
  ls.forEach((l, i) => verdictIn(l, SUGGESTED_RATING) && report(f, i + 1, "suggested-rating-in-calibration", l));
  // A comparison table has one person per row: count the distinct people named alone in the
  // first column across the whole table (full names, short names, slugs or logins).
  // A cell naming two people ("mentors A7 and A4") is context, not a comparison.
  let start = -1;
  const seen = new Set();
  const flush = (end) => {
    if (start >= 0 && seen.size >= 2) report(f, start + 1, "people-compared-in-calibration", `table rows name ${[...seen].join(", ")}`);
    start = -1;
    seen.clear();
  };
  ls.forEach((l, i) => {
    if (!/^\s*\|/.test(l)) return flush(i);
    if (start < 0) start = i;
    const first = l.split("|")[1] ?? "";
    const named = people.filter((p) => nameRe(p).test(first));
    if (named.length === 1) seen.add(named[0].name);
  });
  flush(ls.length);
}

// 10. Delegation: matches by stated goals, never by workload, output or availability ----------
const LOAD_REASON = /\b(least busy|less busy|most available|has (the )?(most )?(bandwidth|capacity|time)|spare (capacity|cycles|time)|lower (workload|output)|fewest (PRs|tickets|commits)|not (very )?busy|under-?utili[sz]ed|low (output|performer))\b/i;
for (const f of examples.filter((x) => x.startsWith("examples/delegation-board/"))) {
  lines(f).forEach((l, i) => verdictIn(l, LOAD_REASON) && report(f, i + 1, "workload-reason-in-delegation", l));
}

// 11. Team pulse: themes, never quotes ------------------------------------------------------------
// Any survey comment from the fixtures that appears in a pulse output, even as a 4-word run, fails.
// A small CSV reader: quoted fields may hold commas, newlines and doubled quotes.
function parseCsv(text) {
  const rows = [];
  let row = [], field = "", quoted = false;
  for (let i = 0; i < text.length; i++) {
    const ch = text[i];
    if (quoted) {
      if (ch === '"' && text[i + 1] === '"') { field += '"'; i++; }
      else if (ch === '"') quoted = false;
      else field += ch;
    } else if (ch === '"') quoted = true;
    else if (ch === ",") { row.push(field); field = ""; }
    else if (ch === "\n" || ch === "\r") {
      if (ch === "\r" && text[i + 1] === "\n") i++;
      row.push(field); rows.push(row); row = []; field = "";
    } else field += ch;
  }
  if (field || row.length) { row.push(field); rows.push(row); }
  return rows;
}
const pulseComments = [];
const pulseDir = join(ROOT, "fixtures/pulse");
for (const name of existsSync(pulseDir) ? readdirSync(pulseDir).filter((x) => x.endsWith(".csv")) : []) {
  const [header = [], ...body] = parseCsv(readFileSync(join(pulseDir, name), "utf8"));
  const col = header.findIndex((h) => /^comments?$/i.test(h.trim()));
  if (col < 0) continue;
  for (const r of body) if (r[col]?.trim()) pulseComments.push(r[col].trim().toLowerCase());
}
const runs = (text, n = 4) => {
  const w = text.toLowerCase().replace(/[^a-z0-9 ]/g, " ").split(/\s+/).filter(Boolean);
  return w.length < n ? [] : w.slice(0, w.length - n + 1).map((_, i) => w.slice(i, i + n).join(" "));
};
const commentRuns = new Set(pulseComments.flatMap((c) => runs(c)));
for (const f of examples.filter((x) => x.startsWith("examples/team-pulse/"))) {
  lines(f).forEach((l, i) => {
    const hit = runs(l).find((r) => commentRuns.has(r));
    if (hit) report(f, i + 1, "pulse-comment-quoted", `"${hit}" comes from a survey comment`);
  });
}

// 12. RFC review: the document, never the author ---------------------------------------------------
const ABOUT_AUTHOR = /\b((the )?author('s)?|(engineer )?[A-Z]\d+|they|he|she) (is|was|seems|appears|looks|isn't|wasn't) (careless|sloppy|lazy|junior|inexperienced|rushed|confused|out of (their|his|her) depth|(not )?(senior|experienced|ready) enough)\b|\b(careless|sloppy|lazy) (author|writer|engineer)\b/i;
for (const f of examples.filter((x) => x.startsWith("examples/rfc-review/"))) {
  lines(f).forEach((l, i) => verdictIn(l, ABOUT_AUTHOR) && report(f, i + 1, "author-judged-in-rfc-review", l));
}

// Report ----------------------------------------------------------------------------------
if (findings.length) {
  for (const x of findings) console.log(`${x.file}:${x.line}  [${x.rule}]  ${x.text}`);
  console.log(`\nscripts/lint: ${findings.length} finding(s).`);
  process.exit(1);
}
console.log(`scripts/lint: clean (${repoFiles().length} files, ${examples.length} examples, ${people.length} fixture people checked).`);
