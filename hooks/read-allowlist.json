{
  "_comment": "Read tools each official server may call through em-tools. Anything not listed is blocked. Server keys match .mcp.json.",
  "servers": {
    "em-tools": {
      "integration": null,
      "allow": "*"
    },
    "github": {
      "integration": [
        "github"
      ],
      "allow": [
        "get_me",
        "get_teams",
        "get_team_members",
        "get_file_contents",
        "get_repository_tree",
        "get_commit",
        "list_commits",
        "search_commits",
        "list_branches",
        "list_tags",
        "get_tag",
        "list_releases",
        "get_latest_release",
        "get_release_by_tag",
        "list_pull_requests",
        "pull_request_read",
        "search_pull_requests",
        "list_issues",
        "issue_read",
        "search_issues",
        "list_issue_types",
        "list_issue_fields",
        "get_label",
        "list_label",
        "search_code",
        "search_repositories",
        "search_users",
        "search_orgs",
        "list_repository_collaborators",
        "actions_list",
        "actions_get",
        "get_job_logs"
      ]
    },
    "atlassian": {
      "integration": [
        "jira"
      ],
      "allow": [
        "atlassianUserInfo",
        "getAccessibleAtlassianResources",
        "searchJiraIssuesUsingJql",
        "getJiraIssue",
        "getJiraIssueRemoteIssueLinks",
        "getTransitionsForJiraIssue",
        "lookupJiraAccountId",
        "listJiraProjects",
        "getVisibleJiraProjects",
        "listJiraProjectIssueTypesMetadata",
        "getJiraProjectIssueTypesMetadata",
        "getJiraIssueTypeMetaWithFields",
        "search",
        "fetch"
      ]
    },
    "linear": {
      "integration": [
        "linear"
      ],
      "allow": [
        "list_issues",
        "get_issue",
        "list_comments",
        "list_cycles",
        "list_projects",
        "get_project",
        "list_teams",
        "get_team",
        "list_users",
        "get_user",
        "list_documents",
        "get_document",
        "list_issue_statuses",
        "get_issue_status",
        "list_issue_labels",
        "list_project_labels",
        "list_milestones",
        "get_milestone",
        "get_status_updates",
        "list_custom_views",
        "get_workspace"
      ]
    },
    "google-calendar": {
      "integration": [
        "google_calendar"
      ],
      "allow": [
        "list_calendars",
        "list_events",
        "get_event",
        "search_events",
        "suggest_time"
      ]
    },
    "slack": {
      "integration": [
        "slack"
      ],
      "allow": [
        "slack_search_public",
        "slack_search_channels",
        "slack_read_channel",
        "slack_read_thread"
      ]
    },
    "workiq": {
      "integration": [
        "outlook",
        "teams"
      ],
      "allow": [
        "ask",
        "list_agents",
        "ask_work_iq",
        "fetch_work_iq",
        "fetch_blob_work_iq",
        "get_schema_work_iq",
        "search_paths_work_iq"
      ],
      "_note": "accept_eula is blocked on purpose: the EM accepts the Work IQ licence terms themselves."
    },
    "pagerduty": {
      "integration": [
        "pagerduty"
      ],
      "_note": "Read tools from PagerDuty's official server (pagerduty_mcp/tools/__init__.py, checked 2026-10-24). Per-person tools (list_users, get_user_data, list_team_members, get_responder_metrics, get_responder_load_metrics) are left out on purpose.",
      "allow": [
        "list_incidents",
        "get_incident",
        "get_outlier_incident",
        "get_past_incidents",
        "get_related_incidents",
        "list_incident_notes",
        "list_alerts_from_incident",
        "get_alert_from_incident",
        "list_alert_grouping_settings",
        "get_alert_grouping_setting",
        "list_change_events",
        "get_change_event",
        "list_service_change_events",
        "list_incident_change_events",
        "list_services",
        "get_service",
        "get_technical_service_dependencies",
        "list_teams",
        "get_team",
        "list_schedules",
        "get_schedule",
        "list_schedule_users",
        "list_oncalls",
        "list_log_entries",
        "get_log_entry",
        "list_escalation_policies",
        "get_escalation_policy",
        "list_priorities",
        "get_incident_metrics_by_service",
        "get_incident_metrics_by_team",
        "get_incident_metrics_all",
        "list_business_services",
        "get_business_service_dependencies"
      ]
    },
    "incident-io": {
      "integration": [
        "incident_io"
      ],
      "_note": "incident.io publishes no tool list we could verify (2026-10-24), so every tool is blocked until read tools are confirmed and added here. Use an incident.io export meanwhile.",
      "allow": []
    }
  }
}
